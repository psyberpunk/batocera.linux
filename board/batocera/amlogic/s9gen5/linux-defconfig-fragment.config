# Batocera additions on top of the CoreELEC 22 (Amlogic-no) kernel config

# required for batocera squashfs / overlay root
CONFIG_NLS_ISO8859_1=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CHR_DEV_SG=m

# keep the module directory equal to the plain kernel version
# CONFIG_LOCALVERSION_AUTO is not set

# logo
# CONFIG_LOGO is not set

# required for evmapy
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_JOYDEV=y

# Playstation DS4 / DS5 controller support
CONFIG_HID_LED=m
CONFIG_LEDS_CLASS_MULTICOLOR=m
CONFIG_HID_PLAYSTATION=m
CONFIG_PLAYSTATION_FF=y

# CoreELEC generates gpio_data.h for this helper from the bl30 sources at
# build time; it only drives GPIO power-on from config.ini, not needed here
# CONFIG_BL30_MANAGER is not set

# Mali is driven by the out-of-tree kbase module (mali-kbase-aml)
# CONFIG_DRM_PANFROST is not set
# CONFIG_DRM_LIMA is not set

# Logitech wheels: new-lg4ff builds against these (off in the CoreELEC config)
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_LOGITECH_HIDPP=m
CONFIG_LOGITECH_FF=y
CONFIG_LOGIWHEELS_FF=y
