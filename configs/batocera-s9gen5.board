include batocera-board.common

# Target definition
BR2_aarch64=y
BR2_cortex_a55=y
BR2_ARM_FPU_NEON_FP_ARMV8=y
BR2_PACKAGE_BATOCERA_TARGET_S9GEN5=y
BR2_TARGET_OPTIMIZATION="-pipe -fsigned-char"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_KEEP=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/patches $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/amlogic/patches $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/amlogic/s9gen5/patches"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/fsoverlay $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/amlogic/fsoverlay $(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/amlogic/s9gen5/fsoverlay"

# Linux headers: mainline 5.15, see a3gen2 for why vendor headers are not used
BR2_KERNEL_HEADERS_5_15=y

# Kernel: CoreELEC Amlogic 5.15 (the one CoreELEC 22 ships for S7D/S905X5M)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
# CoreELEC/linux-amlogic, as pinned by CoreELEC coreelec-22 (please update when updating the ref)
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/CoreELEC/linux-amlogic/archive/69e87fa40cc3a04bf91d92e388d2787a2efcb50c.tar.gz"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/amlogic/s9gen5/linux_patches"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/amlogic/s9gen5/linux-coreelec-5.15.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/amlogic/s9gen5/linux-defconfig-fragment.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
# The Amlogic u-boot bootm expects an LZO kernel inside the Android boot image
BR2_LINUX_KERNEL_IMAGE_TARGET_CUSTOM=y
BR2_LINUX_KERNEL_IMAGE_TARGET_NAME="Image.lzo"
BR2_LINUX_KERNEL_LZO=y
# CoreELEC/common_drivers, as pinned by CoreELEC coreelec-22 (please update when updating the ref)
BR2_PACKAGE_AMLOGIC_COMMON_DRIVERS=y
BR2_PACKAGE_AMLOGIC_COMMON_DRIVERS_REPOSITORY="https://github.com/CoreELEC/common_drivers.git"
BR2_PACKAGE_AMLOGIC_COMMON_DRIVERS_VERSION="dc8d2939a7b0204e9b54a3234b8edd338b17e1bd"

# Build the DTB from the kernel sources
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="s7d_s905a_bm221 s7d_s905x5m_2g_1gbit s7d_s905x5m_2g s7d_s905x5m_4g_1gbit s7d_s905x5m_4g"

# System
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y

# GPU: Mali-G310 binary driver (no mesa, panthor needs a 6.10+ kernel)
BR2_PACKAGE_MALI_G310=y
BR2_PACKAGE_MALI_KBASE_AML=y
BR2_PACKAGE_BATOCERA_WAYLAND_LABWC=y
# gstreamer GL elements (BATOCERA_VIDEO_CODECS selects the sub options)
BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL=y

# Wifi
BR2_PACKAGE_RTL8733BS=y

# Bluetooth (RTL8733BS over UART, userspace H5 loader)
BR2_PACKAGE_RTKBT_AML=y

# Filesystem tools
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y

# choices can be put in _defconfig files only
BR2_PACKAGE_BATOCERA_SPLASH_MPV=y
