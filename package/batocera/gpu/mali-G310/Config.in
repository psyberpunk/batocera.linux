config BR2_PACKAGE_MALI_G310
	bool "mali-G310"
	depends on BR2_aarch64
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_WAYLAND
	select BR2_PACKAGE_LINUX_FIRMWARE
	select BR2_PACKAGE_LINUX_FIRMWARE_ARM_MALI_CSF
	select BR2_PACKAGE_HAS_LIBEGL
	select BR2_PACKAGE_HAS_LIBGLES
	select BR2_PACKAGE_HAS_LIBMALI
	select BR2_PACKAGE_HAS_LIBGBM
	select BR2_PACKAGE_LIBGBM_HAS_FEATURE_DMA_BUF
	select BR2_PACKAGE_LIBGBM_HAS_FEATURE_FORMAT_MODIFIER_PLANE_COUNT
	help
	  Install the binary user-space libraries for the ARM Mali
	  G310 GPU found in Amlogic S7D/S6 (S905X5/S905X5M), as
	  shipped by CoreELEC (Valhall r44p0, wayland + gbm, dma-heap).
	  Requires the mali-kbase-aml kernel driver.

if BR2_PACKAGE_MALI_G310

config BR2_PACKAGE_PROVIDES_LIBMALI
	default "mali-G310"

config BR2_PACKAGE_PROVIDES_LIBEGL
	default "mali-G310"

config BR2_PACKAGE_PROVIDES_LIBGLES
	default "mali-G310"

config BR2_PACKAGE_PROVIDES_LIBGBM
	default "mali-G310"

endif
